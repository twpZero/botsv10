{
  "name": "bots-notepad-tools",
  "private": true,
  "type": "module",
  "description": "Build and test tooling. The site itself needs no build step; this only regenerates vendor/vendor.js and runs the tests.",
  "scripts": {
    "vendor": "esbuild vendor-entry.js --bundle --format=esm --minify --target=es2020 --outfile=../vendor/vendor.js",
    "serve": "node serve.mjs",
    "test": "node test-e2e.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "htm": "^3.1.1",
    "marked": "^15.0.0",
    "preact": "^10.26.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "ws": "^8.18.0"
  }
}
